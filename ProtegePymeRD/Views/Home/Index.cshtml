@model ProtegePymeRD.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var score = Model.ProtegeScorePromedio;

    var scoreNombre = score switch
    {
        >= 90 => "Excelente",
        >= 75 => "Bueno",
        >= 60 => "Moderado",
        >= 40 => "Bajo",
        > 0 => "Crítico",
        _ => "Sin evaluar"
    };

    var scoreClase = score switch
    {
        >= 90 => "score-excellent",
        >= 75 => "score-good",
        >= 60 => "score-medium",
        >= 40 => "score-low",
        > 0 => "score-critical",
        _ => "score-empty"
    };

    var porcentajeRestauraciones =
        Model.TotalRespaldos > 0
            ? (int)Math.Round(
                Model.RestauracionesVerificadas * 100.0 /
                Model.TotalRespaldos)
            : 0;

    var totalPrioridades =
        Model.AlertasCriticasAbiertas +
        Model.PlanesRequierenRevision +
        Math.Max(
            Model.CuentasCriticasActivas - Model.CuentasConMfa,
            0);

    var cuentasSinMfa =
        Math.Max(
            Model.CuentasCriticasActivas - Model.CuentasConMfa,
            0);
}


<!-- ======================================================
     CABECERA
======================================================= -->

<div class="dashboard-header">

    <div>
        <span class="page-eyebrow">
            PILOTO DE 90 DÍAS
        </span>

        <h1 class="page-title">
            Estado de protección
        </h1>

        <p class="page-description">
            Una vista clara del nivel de seguridad,
            recuperación y continuidad de las MIPYMES protegidas.
        </p>
    </div>

    <div class="dashboard-header-actions">

        <a asp-controller="Empresas"
           asp-action="Index"
           class="btn btn-light border px-3">
            Ver empresas
        </a>

        <a asp-controller="Empresas"
           asp-action="Create"
           class="btn btn-primary px-4">
            Registrar empresa
        </a>

    </div>

</div>


<!-- ======================================================
     MÉTRICAS PRINCIPALES
======================================================= -->

<div class="row g-3 mb-4">

    <!-- PROTEGESCORE -->

    <div class="col-sm-6 col-xl-3">

        <div class="dashboard-stat-card">

            <div class="stat-card-header">

                <span class="stat-label">
                    ProtegeScore
                </span>

                <span class="stat-icon stat-icon-blue">
                    PS
                </span>

            </div>

            @if (score == 0)
            {
                <div class="stat-main-value">
                    --
                </div>

                <div class="stat-footer">
                    Sin evaluaciones realizadas
                </div>
            }
            else
            {
                <div class="stat-value-row">

                    <span class="stat-main-value">
                        @score
                    </span>

                    <span class="stat-value-total">
                        /100
                    </span>

                </div>

                <div class="stat-footer">

                    <span class="score-state-pill @scoreClase">
                        @scoreNombre
                    </span>

                    <span>
                        Promedio general
                    </span>

                </div>
            }

        </div>

    </div>


    <!-- EMPRESAS -->

    <div class="col-sm-6 col-xl-3">

        <div class="dashboard-stat-card">

            <div class="stat-card-header">

                <span class="stat-label">
                    Empresas protegidas
                </span>

                <span class="stat-icon stat-icon-green">
                    EM
                </span>

            </div>

            <div class="stat-main-value">
                @Model.EmpresasActivas
            </div>

            <div class="stat-footer">
                @Model.TotalEmpresas registradas
            </div>

        </div>

    </div>


    <!-- RIESGOS -->

    <div class="col-sm-6 col-xl-3">

        <div class="dashboard-stat-card">

            <div class="stat-card-header">

                <span class="stat-label">
                    Riesgos críticos
                </span>

                <span class="stat-icon stat-icon-red">
                    !
                </span>

            </div>

            <div class="stat-main-value
                 @(Model.AlertasCriticasAbiertas > 0
                     ? "text-danger"
                     : "")">

                @Model.AlertasCriticasAbiertas

            </div>

            <div class="stat-footer">

                @if (Model.AlertasCriticasAbiertas > 0)
                {
                    <span class="text-danger">
                        Requieren atención
                    </span>
                }
                else
                {
                    <span class="text-success">
                        Sin alertas críticas
                    </span>
                }

            </div>

        </div>

    </div>


    <!-- BACKUPS -->

    <div class="col-sm-6 col-xl-3">

        <div class="dashboard-stat-card">

            <div class="stat-card-header">

                <span class="stat-label">
                    Backups correctos
                </span>

                <span class="stat-icon stat-icon-purple">
                    BK
                </span>

            </div>

            @if (Model.TotalRespaldos == 0)
            {
                <div class="stat-main-value">
                    --
                </div>

                <div class="stat-footer">
                    Sin respaldos registrados
                </div>
            }
            else
            {
                <div class="stat-main-value">
                    @Model.PorcentajeRespaldosExitosos%
                </div>

                <div class="stat-footer">

                    @Model.RespaldosExitosos de
                    @Model.TotalRespaldos exitosos

                </div>
            }

        </div>

    </div>

</div>


<!-- ======================================================
     BLOQUE CENTRAL
======================================================= -->

<div class="row g-4 mb-4">


    <!-- ESTADO GENERAL / PROTEGESCORE -->

    <div class="col-xl-8">

        <div class="dashboard-panel h-100">

            <div class="dashboard-panel-header">

                <div>
                    <span class="panel-eyebrow">
                        NIVEL GENERAL
                    </span>

                    <h2 class="panel-title">
                        Estado de protección
                    </h2>

                    <p class="panel-description">
                        Los principales controles que determinan
                        la preparación de las empresas.
                    </p>
                </div>

            </div>


            <div class="dashboard-panel-body">

                <div class="security-overview">


                    <!-- SCORE GRANDE -->

                    <div class="security-score-section">

                        <div class="security-score-ring @scoreClase">

                            <div>
                                @if (score == 0)
                                {
                                    <span class="security-score-number">
                                        --
                                    </span>
                                }
                                else
                                {
                                    <span class="security-score-number">
                                        @score
                                    </span>

                                    <span class="security-score-total">
                                        /100
                                    </span>
                                }
                            </div>

                        </div>


                        <div class="security-score-info">

                            <span class="security-score-status @scoreClase">
                                @scoreNombre
                            </span>

                            @if (score == 0)
                            {
                                <p>
                                    Completa una evaluación para
                                    obtener el ProtegeScore inicial.
                                </p>
                            }
                            else
                            {
                                <p>
                                    Este valor resume el estado
                                    promedio de protección de las
                                    empresas evaluadas.
                                </p>
                            }

                            <div class="security-score-evaluations">

                                <strong>
                                    @Model.EvaluacionesPendientes
                                </strong>

                                evaluaciones pendientes

                            </div>

                        </div>

                    </div>


                    <!-- COBERTURA -->

                    <div class="security-coverage">

                        <div class="coverage-item">

                            <div class="coverage-header">

                                <span>
                                    MFA
                                </span>

                                <strong>
                                    @(Model.CuentasCriticasActivas == 0
                                        ? "--"
                                        : $"{Model.PorcentajeCoberturaMfa}%")
                                </strong>

                            </div>

                            <div class="coverage-track">

                                <div class="coverage-progress"
                                     style="width:
                                        @(Model.CuentasCriticasActivas == 0
                                            ? 0
                                            : Model.PorcentajeCoberturaMfa)%">
                                </div>

                            </div>

                            <small>
                                Protección de cuentas críticas
                            </small>

                        </div>


                        <div class="coverage-item">

                            <div class="coverage-header">

                                <span>
                                    Backups
                                </span>

                                <strong>
                                    @(Model.TotalRespaldos == 0
                                        ? "--"
                                        : $"{Model.PorcentajeRespaldosExitosos}%")
                                </strong>

                            </div>

                            <div class="coverage-track">

                                <div class="coverage-progress"
                                     style="width:
                                        @(Model.TotalRespaldos == 0
                                            ? 0
                                            : Model.PorcentajeRespaldosExitosos)%">
                                </div>

                            </div>

                            <small>
                                Respaldos ejecutados correctamente
                            </small>

                        </div>


                        <div class="coverage-item">

                            <div class="coverage-header">

                                <span>
                                    Restauraciones
                                </span>

                                <strong>
                                    @(Model.TotalRespaldos == 0
                                        ? "--"
                                        : $"{porcentajeRestauraciones}%")
                                </strong>

                            </div>

                            <div class="coverage-track">

                                <div class="coverage-progress"
                                     style="width: @porcentajeRestauraciones%">
                                </div>

                            </div>

                            <small>
                                Backups cuya recuperación fue probada
                            </small>

                        </div>


                        <div class="coverage-item">

                            <div class="coverage-header">

                                <span>
                                    Capacitación
                                </span>

                                <strong>
                                    @(Model.ParticipantesCapacitados == 0
                                        ? "--"
                                        : $"{Model.PorcentajeAprobacionCapacitaciones}%")
                                </strong>

                            </div>

                            <div class="coverage-track">

                                <div class="coverage-progress"
                                     style="width:
                                        @(Model.ParticipantesCapacitados == 0
                                            ? 0
                                            : Model.PorcentajeAprobacionCapacitaciones)%">
                                </div>

                            </div>

                            <small>
                                Participantes que aprobaron
                            </small>

                        </div>


                        <div class="coverage-item mb-0">

                            <div class="coverage-header">

                                <span>
                                    Continuidad
                                </span>

                                <strong>
                                    @(Model.TotalPlanesContinuidad == 0
                                        ? "--"
                                        : $"{Model.PorcentajePlanesProbados}%")
                                </strong>

                            </div>

                            <div class="coverage-track">

                                <div class="coverage-progress"
                                     style="width:
                                        @(Model.TotalPlanesContinuidad == 0
                                            ? 0
                                            : Model.PorcentajePlanesProbados)%">
                                </div>

                            </div>

                            <small>
                                Planes que ya fueron probados
                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- PRIORIDADES -->

    <div class="col-xl-4">

        <div class="dashboard-panel h-100">

            <div class="dashboard-panel-header">

                <div>

                    <span class="panel-eyebrow">
                        ATENCIÓN
                    </span>

                    <h2 class="panel-title">
                        Qué debes revisar
                    </h2>

                    <p class="panel-description">
                        Prioridades que pueden afectar
                        el nivel de protección.
                    </p>

                </div>


                @if (totalPrioridades > 0)
                {
                    <span class="priority-total">
                        @totalPrioridades
                    </span>
                }

            </div>


            <div class="dashboard-panel-body pt-2">


                <!-- ALERTAS -->

                <div class="priority-item">

                    <div class="priority-indicator priority-danger">
                    </div>

                    <div class="priority-content">

                        <div class="priority-heading">

                            <strong>
                                Alertas críticas
                            </strong>

                            <span class="priority-value
                                         @(Model.AlertasCriticasAbiertas > 0
                                             ? "text-danger"
                                             : "text-success")">

                                @Model.AlertasCriticasAbiertas

                            </span>

                        </div>

                        <p>
                            @(Model.AlertasCriticasAbiertas > 0
                                ? "Existen riesgos que requieren atención inmediata."
                                : "No existen alertas críticas abiertas.")
                        </p>

                    </div>

                </div>


                <!-- MFA -->

                <div class="priority-item">

                    <div class="priority-indicator priority-warning">
                    </div>

                    <div class="priority-content">

                        <div class="priority-heading">

                            <strong>
                                Cuentas sin MFA
                            </strong>

                            <span class="priority-value
                                         @(cuentasSinMfa > 0
                                             ? "text-warning"
                                             : "text-success")">

                                @cuentasSinMfa

                            </span>

                        </div>

                        <p>
                            @(cuentasSinMfa > 0
                                ? "Estas cuentas críticas necesitan una segunda capa de autenticación."
                                : "Las cuentas críticas activas tienen MFA.")
                        </p>

                    </div>

                </div>


                <!-- CONTINUIDAD -->

                <div class="priority-item">

                    <div class="priority-indicator priority-info">
                    </div>

                    <div class="priority-content">

                        <div class="priority-heading">

                            <strong>
                                Planes por revisar
                            </strong>

                            <span class="priority-value">
                                @Model.PlanesRequierenRevision
                            </span>

                        </div>

                        <p>
                            @(Model.PlanesRequierenRevision > 0
                                ? "Hay planes vencidos o que necesitan actualización."
                                : "Todos los planes registrados están vigentes.")
                        </p>

                    </div>

                </div>


                <!-- EVALUACIONES -->

                <div class="priority-item mb-0">

                    <div class="priority-indicator priority-neutral">
                    </div>

                    <div class="priority-content">

                        <div class="priority-heading">

                            <strong>
                                Diagnósticos pendientes
                            </strong>

                            <span class="priority-value">
                                @Model.EvaluacionesPendientes
                            </span>

                        </div>

                        <p>
                            @(Model.EvaluacionesPendientes > 0
                                ? "Estas empresas todavía no tienen un ProtegeScore."
                                : "Todas las empresas tienen evaluación inicial.")
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- ======================================================
     CONTINUIDAD + PILOTO
======================================================= -->

<div class="row g-4 mb-4">


    <div class="col-lg-8">

        <div class="dashboard-panel">

            <div class="dashboard-panel-header">

                <div>

                    <span class="panel-eyebrow">
                        OPERACIÓN
                    </span>

                    <h2 class="panel-title">
                        Continuidad y preparación
                    </h2>

                </div>

            </div>


            <div class="dashboard-panel-body">

                <div class="operation-grid">


                    <div class="operation-item">

                        <span class="operation-value">
                            @Model.RestauracionesVerificadas
                        </span>

                        <strong>
                            Restauraciones verificadas
                        </strong>

                        <small>
                            de @Model.TotalRespaldos respaldos
                        </small>

                    </div>


                    <div class="operation-item">

                        <span class="operation-value">
                            @Model.CuentasConMinimoPrivilegio
                        </span>

                        <strong>
                            Accesos controlados
                        </strong>

                        <small>
                            cumplen mínimo privilegio
                        </small>

                    </div>


                    <div class="operation-item">

                        <span class="operation-value">
                            @Model.CapacitacionesCompletadas
                        </span>

                        <strong>
                            Capacitaciones
                        </strong>

                        <small>
                            completadas
                        </small>

                    </div>


                    <div class="operation-item">

                        <span class="operation-value">
                            @Model.PlanesActivos
                        </span>

                        <strong>
                            Planes activos
                        </strong>

                        <small>
                            de @Model.TotalPlanesContinuidad registrados
                        </small>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- PILOTO -->

    <div class="col-lg-4">

        <div class="dashboard-panel">

            <div class="dashboard-panel-header">

                <div>

                    <span class="panel-eyebrow">
                        META
                    </span>

                    <h2 class="panel-title">
                        Piloto de 90 días
                    </h2>

                </div>

            </div>


            <div class="dashboard-panel-body">

                <div class="pilot-progress-header">

                    <div>

                        <strong class="pilot-value">
                            @Model.TotalEmpresas
                        </strong>

                        <span class="pilot-total">
                            / @Model.MetaPiloto
                        </span>

                    </div>

                    <span class="pilot-percentage">
                        @Model.PorcentajePiloto%
                    </span>

                </div>


                <div class="pilot-progress-track">

                    <div class="pilot-progress-value"
                         style="width: @Model.PorcentajePiloto%">
                    </div>

                </div>


                <p class="pilot-description">

                    @if (Model.TotalEmpresas >= Model.MetaPiloto)
                    {
                        <text>
                            La meta inicial de empresas
                            incorporadas fue alcanzada.
                        </text>
                    }
                    else
                    {
                        <text>
                            Faltan
                            <strong>
                                @(Model.MetaPiloto - Model.TotalEmpresas)
                            </strong>
                            empresas para completar la meta
                            del piloto.
                        </text>
                    }

                </p>

            </div>

        </div>

    </div>

</div>


<!-- ======================================================
     EMPRESAS RECIENTES
======================================================= -->

<div class="dashboard-panel">

    <div class="dashboard-panel-header">

        <div>

            <span class="panel-eyebrow">
                CLIENTES
            </span>

            <h2 class="panel-title">
                Empresas incorporadas recientemente
            </h2>

            <p class="panel-description">
                Últimas MIPYMES registradas en ProtegePyme RD.
            </p>

        </div>


        <a asp-controller="Empresas"
           asp-action="Index"
           class="btn btn-sm btn-light border px-3">
            Ver todas
        </a>

    </div>


    @if (Model.EmpresasRecientes.Any())
    {
        <div class="table-responsive">

            <table class="table dashboard-table">

                <thead>

                    <tr>
                        <th>Empresa</th>
                        <th>Plan</th>
                        <th>ProtegeScore</th>
                        <th>Estado</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var empresa in Model.EmpresasRecientes)
                    {
                        <tr>

                            <td>

                                <div class="company-cell">

                                    <div class="company-avatar">
                                        @empresa.Nombre.Substring(0, 1).ToUpper()
                                    </div>

                                    <div>

                                        <strong>
                                            @empresa.Nombre
                                        </strong>

                                        <small>
                                            @empresa.Sector
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <td>

                                <span class="plan-badge">
                                    @empresa.Plan
                                </span>

                            </td>


                            <td>

                                @if (empresa.ProtegeScore == 0)
                                {
                                    <span class="status-badge status-warning">
                                        Pendiente
                                    </span>
                                }
                                else
                                {
                                    <strong>
                                        @empresa.ProtegeScore
                                    </strong>

                                    <span class="text-muted">
                                        /100
                                    </span>
                                }

                            </td>


                            <td>

                                @if (empresa.Activa)
                                {
                                    <span class="status-badge status-success">
                                        Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge">
                                        Inactiva
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="empty-state">

            <div class="empty-state-symbol">
                P
            </div>

            <h3 class="empty-state-title">
                Todavía no hay empresas
            </h3>

            <p class="empty-state-description">
                Registra la primera MIPYME para comenzar
                a medir su nivel de protección.
            </p>

            <a asp-controller="Empresas"
               asp-action="Create"
               class="btn btn-primary mt-3 px-4">

                Registrar primera empresa

            </a>

        </div>
    }

</div>