@using ProtegePymeRD.Models
@model AlertaSeguridad

@{
    ViewData["Title"] = "Registrar alerta";

    var empresa = ViewBag.Empresa as Empresa;
}

<div class="row justify-content-center">
    <div class="col-xl-9">

        <div class="mb-4">
            <span class="text-success fw-semibold small">
                PROTEGEALERT
            </span>

            <h1 class="fw-bold mt-2 mb-2">
                Registrar alerta de seguridad
            </h1>

            <p class="text-muted mb-1">
                Empresa:
                <strong class="text-dark">@empresa?.Nombre</strong>
            </p>

            <p class="text-muted">
                Documenta el riesgo detectado para darle seguimiento.
            </p>
        </div>

        <form asp-action="Create" method="post">
            <input asp-for="EmpresaId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">

                    <h4 class="fw-bold mb-1">
                        Información de la alerta
                    </h4>

                    <p class="text-muted mb-4">
                        Describe claramente qué ocurrió.
                    </p>

                    <div class="row g-4">

                        <div class="col-12">
                            <label asp-for="Titulo"
                                   class="form-label">
                            </label>

                            <input asp-for="Titulo"
                                   class="form-control"
                                   placeholder="Ejemplo: Equipo sin actualizaciones críticas" />

                            <span asp-validation-for="Titulo"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Descripcion"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Descripcion"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Explica qué se detectó, dónde y cuál puede ser su impacto."></textarea>

                            <span asp-validation-for="Descripcion"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Tipo"
                                   class="form-label">
                            </label>

                            <select asp-for="Tipo"
                                    asp-items="Html.GetEnumSelectList<TipoAlerta>()"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="Tipo"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Severidad"
                                   class="form-label">
                            </label>

                            <select asp-for="Severidad"
                                    asp-items="Html.GetEnumSelectList<SeveridadAlerta>()"
                                    class="form-select">
                            </select>

                            <span asp-validation-for="Severidad"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FechaDeteccion"
                                   class="form-label">
                            </label>

                            <input asp-for="FechaDeteccion"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   type="datetime-local"
                                   class="form-control" />

                            <span asp-validation-for="FechaDeteccion"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Responsable"
                                   class="form-label">
                            </label>

                            <input asp-for="Responsable"
                                   class="form-control"
                                   placeholder="Nombre de la persona asignada" />

                            <span asp-validation-for="Responsable"
                                  class="text-danger"></span>
                        </div>

                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mb-5">
                <a asp-action="Index"
                   asp-route-empresaId="@Model.EmpresaId"
                   class="btn btn-light px-4">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-success px-4">
                    Guardar alerta
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}