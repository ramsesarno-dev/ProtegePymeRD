@using ProtegePymeRD.Models
@model IEnumerable<AlertaSeguridad>

@{
    ViewData["Title"] = "ProtegeAlert";

    var empresa = ViewBag.Empresa as Empresa;
    var alertas = Model.ToList();

    var pendientes = alertas.Count(alerta =>
        alerta.Estado == EstadoAlerta.Abierta ||
        alerta.Estado == EstadoAlerta.EnProceso);

    var criticas = alertas.Count(alerta =>
        alerta.Severidad == SeveridadAlerta.Critica &&
        alerta.Estado != EstadoAlerta.Resuelta &&
        alerta.Estado != EstadoAlerta.Descartada);

    var resueltas = alertas.Count(alerta =>
        alerta.Estado == EstadoAlerta.Resuelta);
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">
        @TempData["MensajeExito"]
    </div>
}

<div class="d-flex flex-column flex-md-row
            justify-content-between align-items-md-end
            gap-3 mb-4">

    <div>
        <span class="text-success fw-semibold small">
            PROTEGEALERT
        </span>

        <h1 class="fw-bold mt-2 mb-2">
            Alertas de seguridad
        </h1>

        <p class="text-muted mb-0">
            Empresa:
            <strong class="text-dark">@empresa?.Nombre</strong>
        </p>
    </div>

    <a asp-action="Create"
       asp-route-empresaId="@empresa?.Id"
       class="btn btn-success px-4">
        Registrar alerta
    </a>
</div>

<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Total de alertas</p>
                <span class="display-6 fw-bold">@alertas.Count</span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Pendientes</p>
                <span class="display-6 fw-bold text-warning">
                    @pendientes
                </span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Críticas abiertas</p>
                <span class="display-6 fw-bold text-danger">
                    @criticas
                </span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">Resueltas</p>
                <span class="display-6 fw-bold text-success">
                    @resueltas
                </span>
            </div>
        </div>
    </div>

</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <h4 class="fw-bold mb-1">
            Registro de alertas
        </h4>

        <p class="text-muted mb-4">
            Consulta los riesgos detectados y las acciones realizadas.
        </p>

        @if (alertas.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Alerta</th>
                            <th>Tipo</th>
                            <th>Severidad</th>
                            <th>Estado</th>
                            <th>Detección</th>
                            <th>Responsable</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var alerta in alertas)
                        {
                            string colorSeveridad = alerta.Severidad switch
                            {
                                SeveridadAlerta.Critica => "danger",
                                SeveridadAlerta.Alta => "danger",
                                SeveridadAlerta.Media => "warning",
                                SeveridadAlerta.Baja => "info",
                                _ => "secondary"
                            };

                            string colorEstado = alerta.Estado switch
                            {
                                EstadoAlerta.Resuelta => "success",
                                EstadoAlerta.EnProceso => "primary",
                                EstadoAlerta.Descartada => "secondary",
                                _ => "warning"
                            };

                            string textoEstado = alerta.Estado switch
                            {
                                EstadoAlerta.EnProceso => "En proceso",
                                _ => alerta.Estado.ToString()
                            };

                            <tr>
                                <td>
                                    <strong>@alerta.Titulo</strong>

                                    <div class="small text-muted">
                                        @alerta.Descripcion
                                    </div>
                                </td>

                                <td>
                                    @Html.DisplayFor(_ => alerta.Tipo)
                                </td>

                                <td>
                                    <span class="badge bg-@colorSeveridad">
                                        @Html.DisplayFor(_ => alerta.Severidad)
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-@colorEstado">
                                        @textoEstado
                                    </span>
                                </td>

                                <td>
                                    @alerta.FechaDeteccion.ToString(
                                    "dd/MM/yyyy hh:mm tt")
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(
                                                        alerta.Responsable)
                                                        ? "Sin asignar"
                                                        : alerta.Responsable)
                        </td>

                                <td class="text-end text-nowrap">
                                    <a asp-action="Resolver"
                                       asp-route-id="@alerta.Id"
                                       class="btn btn-sm btn-outline-success">
                                        Atender
                                    </a>

                                    <form asp-action="Eliminar"
                                          asp-route-id="@alerta.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('¿Seguro que deseas eliminar esta alerta?');">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h5>No hay alertas registradas</h5>

                <p class="text-muted">
                    Registra cualquier vulnerabilidad, acceso sospechoso,
                    malware o fallo detectado.
                </p>

                <a asp-action="Create"
                   asp-route-empresaId="@empresa?.Id"
                   class="btn btn-success">
                    Registrar primera alerta
                </a>
            </div>
        }

    </div>
</div>

<div class="mt-4 mb-5">
    <a asp-controller="Empresas"
       asp-action="Index"
       class="btn btn-light">
        Volver a empresas
    </a>
</div>