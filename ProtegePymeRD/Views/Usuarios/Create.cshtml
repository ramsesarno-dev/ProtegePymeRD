@using ProtegePymeRD.ViewModels
@model CrearUsuarioViewModel

@{
    ViewData["Title"] = "Crear usuario";
}

<div class="row justify-content-center">
    <div class="col-lg-7">

        <div class="mb-4">
            <span class="text-success fw-semibold small">
                CONTROL DE ACCESO
            </span>

            <h1 class="fw-bold mt-2 mb-2">
                Crear usuario
            </h1>

            <p class="text-muted mb-0">
                Registra una cuenta y asigna sus permisos
                dentro de ProtegePyme RD.
            </p>
        </div>

        <div class="alert alert-light border">
            <strong>Requisitos de contraseña:</strong>

            <ul class="mb-0 mt-2">
                <li>Mínimo 8 caracteres.</li>
                <li>Una letra mayúscula.</li>
                <li>Una letra minúscula.</li>
                <li>Un número.</li>
                <li>Un carácter especial.</li>
            </ul>
        </div>

        <form asp-action="Create"
              method="post">

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>
            }

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">

                    <div class="mb-3">
                        <label asp-for="Correo"
                               class="form-label">
                        </label>

                        <input asp-for="Correo"
                               type="email"
                               class="form-control"
                               placeholder="usuario@protegepyme.com"
                               autocomplete="off" />

                        <span asp-validation-for="Correo"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Rol"
                               class="form-label">
                        </label>

                        <select asp-for="Rol"
                                class="form-select">

                            <option value="Analista">
                                Analista
                            </option>

                            <option value="Administrador">
                                Administrador
                            </option>

                        </select>

                        <div class="form-text">
                            El Analista puede consultar empresas y
                            utilizar los módulos operativos.
                        </div>

                        <span asp-validation-for="Rol"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="Contrasena"
                                   class="form-label">
                            </label>

                            <input asp-for="Contrasena"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Contrasena"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmarContrasena"
                                   class="form-label">
                            </label>

                            <input asp-for="ConfirmarContrasena"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmarContrasena"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>

                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-light px-4">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-success px-4">
                    Crear usuario
                </button>

            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}