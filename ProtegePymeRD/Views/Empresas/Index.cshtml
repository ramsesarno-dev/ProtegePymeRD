@model IEnumerable<ProtegePymeRD.Models.Empresa>

@{
    ViewData["Title"] = "Empresas";

    bool esAdministrador =
        User.IsInRole("Administrador");
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">
        @TempData["MensajeExito"]
    </div>
}

@if (TempData["MensajeAdvertencia"] != null)
{
    <div class="alert alert-warning">
        @TempData["MensajeAdvertencia"]
    </div>
}

<div class="d-flex flex-column flex-md-row
            justify-content-between align-items-md-end
            gap-3 mb-4">

    <div>
        <span class="text-success fw-semibold small">
            CLIENTES PROTEGIDOS
        </span>

        <h1 class="fw-bold mt-2 mb-2">
            Empresas
        </h1>

        <p class="text-muted mb-0">
            Consulta y administra las MIPYMES incorporadas
            a ProtegePyme RD.
        </p>
    </div>

    @if (esAdministrador)
    {
        <a asp-action="Create"
           class="btn btn-success px-4">
            Nueva empresa
        </a>
    }

</div>

<div class="row g-3 mb-4">

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">

                <p class="text-muted">
                    Total de empresas
                </p>

                <span class="display-6 fw-bold">
                    @ViewBag.TotalEmpresas
                </span>

            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">

                <p class="text-muted">
                    Empresas activas
                </p>

                <span class="display-6 fw-bold text-success">
                    @ViewBag.EmpresasActivas
                </span>

            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">

                <p class="text-muted">
                    Meta del piloto
                </p>

                <span class="display-6 fw-bold">
                    10
                </span>

                <span class="text-muted">
                    empresas
                </span>

            </div>
        </div>
    </div>

</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <form method="get"
              class="row g-2 mb-4">

            <div class="col-md-7">
                <input type="search"
                       name="buscar"
                       value="@ViewBag.Buscar"
                       class="form-control"
                       placeholder="Buscar por nombre, RNC o sector" />
            </div>

            <div class="col-auto">
                <button class="btn btn-dark"
                        type="submit">
                    Buscar
                </button>
            </div>

            <div class="col-auto">
                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Limpiar
                </a>
            </div>

        </form>

        @if (Model.Any())
        {
            <div class="table-responsive empresas-table">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Empresa</th>
                            <th>RNC o cédula</th>
                            <th>Plan</th>
                            <th>ProtegeScore</th>
                            <th>Estado</th>
                            <th>Incorporación</th>
                            <th class="text-end">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var empresa in Model)
                        {
                            <tr>
                                <td>
                                    <strong>
                                        @empresa.Nombre
                                    </strong>

                                    <div class="text-muted small">
                                        @empresa.Sector ·
                                        @empresa.CantidadEmpleados
                                        empleados
                                    </div>
                                </td>

                                <td>
                                    @empresa.Rnc
                                </td>

                                <td>
                                    <span class="badge
                                                         bg-light
                                                         text-dark
                                                         border">
                                        @empresa.Plan
                                    </span>
                                </td>

                                <td>
                                    @if (empresa.ProtegeScore == 0)
                                    {
                                        <span class="badge
                                                                 bg-secondary
                                                                 text-white">
                                            Pendiente
                                        </span>
                                    }
                                    else
                                    {
                                        <strong>
                                            @empresa.ProtegeScore / 100
                                        </strong>
                                    }
                                </td>

                                <td>
                                    @if (empresa.Activa)
                                    {
                                        <span class="text-success
                                                                 fw-semibold">
                                            Activa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Inactiva
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(empresa.FechaRegistro.ToString("dd/MM/yyyy"))
                                </td>

                                <td class="text-end text-nowrap"
                                    style="min-width: 285px;">

                                    <div class="d-flex
                                                        justify-content-end
                                                        gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@empresa.Id"
                                           class="btn btn-sm
                                                          btn-outline-dark">
                                            Ver
                                        </a>

                                        <div class="dropdown">

                                            <button type="button"
                                                    class="btn btn-sm
                                                                   btn-outline-success
                                                                   dropdown-toggle"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false">
                                                Servicios
                                            </button>

                                            <ul class="dropdown-menu
                                                               dropdown-menu-end
                                                               shadow">

                                                <li>
                                                    <h6 class="dropdown-header">
                                                        Seguridad y acceso
                                                    </h6>
                                                </li>

                                                <li>
                                                    <a asp-controller="CuentasCriticas"
                                                       asp-action="Index"
                                                       asp-route-empresaId="@empresa.Id"
                                                       class="dropdown-item">
                                                        ProtegeAccess
                                                    </a>
                                                </li>

                                                <li>
                                                    <a asp-controller="AlertasSeguridad"
                                                       asp-action="Index"
                                                       asp-route-empresaId="@empresa.Id"
                                                       class="dropdown-item">
                                                        ProtegeAlert
                                                    </a>
                                                </li>

                                                <li>
                                                    <a asp-controller="CapacitacionesSeguridad"
                                                       asp-action="Index"
                                                       asp-route-empresaId="@empresa.Id"
                                                       class="dropdown-item">
                                                        ProtegeHuman
                                                    </a>
                                                </li>

                                                <li>
                                                    <hr class="dropdown-divider" />
                                                </li>

                                                <li>
                                                    <h6 class="dropdown-header">
                                                        Evaluación
                                                    </h6>
                                                </li>

                                                <li>
                                                    <a asp-controller="Diagnosticos"
                                                       asp-action="Create"
                                                       asp-route-empresaId="@empresa.Id"
                                                       class="dropdown-item">
                                                        Nuevo diagnóstico
                                                    </a>
                                                </li>

                                                <li>
                                                    <a asp-controller="Diagnosticos"
                                                       asp-action="Historial"
                                                       asp-route-empresaId="@empresa.Id"
                                                       class="dropdown-item">
                                                        Historial ProtegeScore
                                                    </a>
                                                </li>

                                                <li>
                                                    <hr class="dropdown-divider" />
                                                </li>

                                                <li>
                                                    <h6 class="dropdown-header">
                                                        Recuperación
                                                    </h6>
                                                </li>

                                                <li>
                                                    <a asp-controller="Respaldos"
                                                       asp-action="Index"
                                                       asp-route-empresaId="@empresa.Id"
                                                       class="dropdown-item">
                                                        ProtegeBackup
                                                    </a>
                                                </li>

                                                <li>
                                                    <a asp-controller="PlanesContinuidad"
                                                       asp-action="Index"
                                                       asp-route-empresaId="@empresa.Id"
                                                       class="dropdown-item">
                                                        Plan de continuidad
                                                    </a>
                                                </li>

                                            </ul>
                                        </div>

                                        @if (esAdministrador)
                                        {
                                            <div class="dropdown">

                                                <button type="button"
                                                        class="btn btn-sm
                                                                           btn-outline-secondary
                                                                           dropdown-toggle"
                                                        data-bs-toggle="dropdown"
                                                        aria-expanded="false">
                                                    Administrar
                                                </button>

                                                <ul class="dropdown-menu
                                                                       dropdown-menu-end
                                                                       shadow">

                                                    <li>
                                                        <a asp-action="Edit"
                                                           asp-route-id="@empresa.Id"
                                                           class="dropdown-item">
                                                            Editar empresa
                                                        </a>
                                                    </li>

                                                    <li>
                                                        <a asp-action="Delete"
                                                           asp-route-id="@empresa.Id"
                                                           class="dropdown-item
                                                                              text-danger">
                                                            Eliminar empresa
                                                        </a>
                                                    </li>

                                                </ul>
                                            </div>
                                        }

                                    </div>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">

                <h5>
                    No hay empresas registradas
                </h5>

                <p class="text-muted">
                    No se encontraron empresas con los
                    criterios indicados.
                </p>

                @if (esAdministrador)
                {
                    <a asp-action="Create"
                       class="btn btn-success mt-2">
                        Registrar empresa
                    </a>
                }

            </div>
        }

    </div>
</div>

<style>
    @@media (min-width: 992px) {
        .empresas-table {
            overflow: visible;
        }
    }
</style>