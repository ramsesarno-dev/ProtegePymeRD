@model ProtegePymeRD.Models.Empresa

@{
    ViewData["Title"] = "Perfil de empresa";

    bool esAdministrador =
        User.IsInRole("Administrador");

    var score = Model.ProtegeScore;

    var scoreNombre = score switch
    {
        >= 90 => "Excelente",
        >= 75 => "Bueno",
        >= 60 => "Moderado",
        >= 40 => "Bajo",
        > 0 => "Crítico",
        _ => "Pendiente"
    };

    var scoreClase = score switch
    {
        >= 90 => "profile-score-excellent",
        >= 75 => "profile-score-good",
        >= 60 => "profile-score-medium",
        >= 40 => "profile-score-low",
        > 0 => "profile-score-critical",
        _ => "profile-score-pending"
    };

    var inicial =
        !string.IsNullOrWhiteSpace(Model.Nombre)
            ? Model.Nombre.Substring(0, 1).ToUpper()
            : "E";
}


<!-- ======================================================
     NAVEGACIÓN SUPERIOR
======================================================= -->

<div class="company-profile-back">

    <a asp-action="Index"
       class="company-back-link">

        ← Empresas

    </a>

</div>


<!-- ======================================================
     CABECERA DE EMPRESA
======================================================= -->

<div class="company-profile-header">

    <div class="company-profile-identity">

        <div class="company-profile-avatar">
            @inicial
        </div>

        <div>

            <div class="company-profile-title-row">

                <h1 class="company-profile-name">
                    @Model.Nombre
                </h1>

                @if (Model.Activa)
                {
                    <span class="company-status company-status-active">

                        <span class="company-status-dot"></span>

                        Activa

                    </span>
                }
                else
                {
                    <span class="company-status company-status-inactive">

                        <span class="company-status-dot"></span>

                        Inactiva

                    </span>
                }

            </div>


            <div class="company-profile-meta">

                <span>
                    @Model.Sector
                </span>

                <span class="profile-meta-dot">
                    •
                </span>

                <span>
                    Plan @Model.Plan
                </span>

                <span class="profile-meta-dot">
                    •
                </span>

                <span>
                    @Model.CantidadEmpleados
                    @(Model.CantidadEmpleados == 1
                        ? "empleado"
                        : "empleados")
                </span>

            </div>

        </div>

    </div>


    <div class="company-profile-actions">

        <a asp-controller="Diagnosticos"
           asp-action="Create"
           asp-route-empresaId="@Model.Id"
           class="btn btn-primary">

            Nuevo diagnóstico

        </a>

        @if (esAdministrador)
        {
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-light border">

                Editar empresa

            </a>
        }

    </div>

</div>


<!-- ======================================================
     RESUMEN PRINCIPAL
======================================================= -->

<div class="row g-3 mb-4">


    <!-- PROTEGESCORE -->

    <div class="col-md-6 col-xl-3">

        <div class="profile-stat-card">

            <div class="profile-stat-header">

                <span>
                    ProtegeScore
                </span>

                <div class="profile-stat-icon profile-stat-blue">
                    PS
                </div>

            </div>


            @if (score == 0)
            {
                <div class="profile-stat-value">
                    --
                </div>

                <div class="profile-stat-footer">

                    <span class="profile-score-badge
                                 profile-score-pending">

                        Pendiente

                    </span>

                </div>
            }
            else
            {
                <div class="profile-score-value-row">

                    <span class="profile-stat-value">
                        @score
                    </span>

                    <span class="profile-stat-total">
                        /100
                    </span>

                </div>


                <div class="profile-stat-footer">

                    <span class="profile-score-badge
                                 @scoreClase">

                        @scoreNombre

                    </span>

                </div>
            }

        </div>

    </div>


    <!-- PLAN -->

    <div class="col-md-6 col-xl-3">

        <div class="profile-stat-card">

            <div class="profile-stat-header">

                <span>
                    Plan contratado
                </span>

                <div class="profile-stat-icon profile-stat-purple">
                    PL
                </div>

            </div>

            <div class="profile-plan-value">
                @Model.Plan
            </div>

            <div class="profile-stat-description">
                Servicio actualmente contratado
            </div>

        </div>

    </div>


    <!-- EMPLEADOS -->

    <div class="col-md-6 col-xl-3">

        <div class="profile-stat-card">

            <div class="profile-stat-header">

                <span>
                    Empleados
                </span>

                <div class="profile-stat-icon profile-stat-green">
                    EM
                </div>

            </div>

            <div class="profile-stat-value">
                @Model.CantidadEmpleados
            </div>

            <div class="profile-stat-description">
                Personal registrado
            </div>

        </div>

    </div>


    <!-- INCORPORACIÓN -->

    <div class="col-md-6 col-xl-3">

        <div class="profile-stat-card">

            <div class="profile-stat-header">

                <span>
                    Incorporación
                </span>

                <div class="profile-stat-icon profile-stat-orange">
                    90D
                </div>

            </div>

            <div class="profile-date-value">
                @(Model.FechaRegistro.ToString("dd/MM/yyyy"))
            </div>

            <div class="profile-stat-description">
                Fecha de entrada a ProtegePyme
            </div>

        </div>

    </div>

</div>


<!-- ======================================================
     NAVEGACIÓN DE SERVICIOS
======================================================= -->

<div class="company-profile-tabs">

    <a href="#resumen"
       class="company-profile-tab active">

        Resumen

    </a>


    <a asp-controller="Diagnosticos"
       asp-action="Historial"
       asp-route-empresaId="@Model.Id"
       class="company-profile-tab">

        ProtegeScore

    </a>


    <a asp-controller="CuentasCriticas"
       asp-action="Index"
       asp-route-empresaId="@Model.Id"
       class="company-profile-tab">

        Accesos

    </a>


    <a asp-controller="Respaldos"
       asp-action="Index"
       asp-route-empresaId="@Model.Id"
       class="company-profile-tab">

        Backups

    </a>


    <a asp-controller="AlertasSeguridad"
       asp-action="Index"
       asp-route-empresaId="@Model.Id"
       class="company-profile-tab">

        Alertas

    </a>


    <a asp-controller="CapacitacionesSeguridad"
       asp-action="Index"
       asp-route-empresaId="@Model.Id"
       class="company-profile-tab">

        Capacitación

    </a>


    <a asp-controller="PlanesContinuidad"
       asp-action="Index"
       asp-route-empresaId="@Model.Id"
       class="company-profile-tab">

        Continuidad

    </a>

</div>


<!-- ======================================================
     CONTENIDO
======================================================= -->

<div id="resumen"
     class="row g-4">


    <!-- ==================================================
         COLUMNA PRINCIPAL
    =================================================== -->

    <div class="col-xl-8">


        <!-- ESTADO DE SEGURIDAD -->

        <div class="profile-panel mb-4">

            <div class="profile-panel-header">

                <div>

                    <span class="panel-eyebrow">
                        ESTADO GENERAL
                    </span>

                    <h2 class="profile-panel-title">
                        Nivel de protección
                    </h2>

                    <p class="profile-panel-description">
                        Resultado más reciente del diagnóstico
                        de seguridad de esta empresa.
                    </p>

                </div>


                <a asp-controller="Diagnosticos"
                   asp-action="Historial"
                   asp-route-empresaId="@Model.Id"
                   class="btn btn-sm btn-light border">

                    Ver historial

                </a>

            </div>


            <div class="profile-panel-body">


                @if (score == 0)
                {
                    <div class="profile-no-score">

                        <div class="profile-no-score-icon">
                            PS
                        </div>

                        <div>

                            <h3>
                                Esta empresa aún no tiene ProtegeScore
                            </h3>

                            <p>
                                Realiza el diagnóstico inicial para
                                identificar brechas y conocer el nivel
                                actual de protección.
                            </p>

                            <a asp-controller="Diagnosticos"
                               asp-action="Create"
                               asp-route-empresaId="@Model.Id"
                               class="btn btn-primary btn-sm px-3">

                                Realizar diagnóstico

                            </a>

                        </div>

                    </div>
                }
                else
                {
                    <div class="profile-score-overview">

                        <div class="profile-score-circle @scoreClase">

                            <div>

                                <strong>
                                    @score
                                </strong>

                                <span>
                                    /100
                                </span>

                            </div>

                        </div>


                        <div class="profile-score-summary">

                            <span class="profile-security-status
                                         @scoreClase">

                                @scoreNombre

                            </span>

                            <h3>
                                Estado actual de seguridad
                            </h3>


                            @if (score >= 90)
                            {
                                <p>
                                    La empresa presenta un nivel alto
                                    de cumplimiento de los controles
                                    evaluados. Es importante mantener
                                    las revisiones y pruebas periódicas.
                                </p>
                            }
                            else if (score >= 75)
                            {
                                <p>
                                    La empresa mantiene una buena
                                    postura de seguridad, aunque todavía
                                    existen controles que pueden fortalecerse.
                                </p>
                            }
                            else if (score >= 60)
                            {
                                <p>
                                    Existen controles implementados,
                                    pero todavía hay brechas importantes
                                    que deben ser atendidas.
                                </p>
                            }
                            else if (score >= 40)
                            {
                                <p>
                                    El nivel de protección necesita
                                    mejoras. Se recomienda priorizar
                                    los controles con mayor impacto.
                                </p>
                            }
                            else
                            {
                                <p>
                                    La empresa presenta brechas
                                    importantes y requiere acciones
                                    de seguridad prioritarias.
                                </p>
                            }


                            <a asp-controller="Diagnosticos"
                               asp-action="Create"
                               asp-route-empresaId="@Model.Id"
                               class="profile-text-link">

                                Realizar nueva evaluación →

                            </a>

                        </div>

                    </div>
                }

            </div>

        </div>


        <!-- SERVICIOS -->

        <div class="profile-panel">

            <div class="profile-panel-header">

                <div>

                    <span class="panel-eyebrow">
                        PROTECCIÓN
                    </span>

                    <h2 class="profile-panel-title">
                        Servicios ProtegePyme
                    </h2>

                    <p class="profile-panel-description">
                        Accede a los controles y procesos asociados
                        con esta empresa.
                    </p>

                </div>

            </div>


            <div class="profile-panel-body">

                <div class="profile-services-grid">


                    <!-- PROTEGESCORE -->

                    <a asp-controller="Diagnosticos"
                       asp-action="Historial"
                       asp-route-empresaId="@Model.Id"
                       class="profile-service-card">

                        <div class="profile-service-icon service-blue">
                            PS
                        </div>

                        <div class="profile-service-content">

                            <h3>
                                ProtegeScore
                            </h3>

                            <p>
                                Diagnósticos, brechas y evolución
                                de la puntuación.
                            </p>

                            <span>
                                Ver diagnóstico →
                            </span>

                        </div>

                    </a>


                    <!-- ACCESS -->

                    <a asp-controller="CuentasCriticas"
                       asp-action="Index"
                       asp-route-empresaId="@Model.Id"
                       class="profile-service-card">

                        <div class="profile-service-icon service-cyan">
                            AC
                        </div>

                        <div class="profile-service-content">

                            <h3>
                                ProtegeAccess
                            </h3>

                            <p>
                                Cuentas críticas, MFA y control
                                de privilegios.
                            </p>

                            <span>
                                Gestionar accesos →
                            </span>

                        </div>

                    </a>


                    <!-- BACKUP -->

                    <a asp-controller="Respaldos"
                       asp-action="Index"
                       asp-route-empresaId="@Model.Id"
                       class="profile-service-card">

                        <div class="profile-service-icon service-purple">
                            BK
                        </div>

                        <div class="profile-service-content">

                            <h3>
                                ProtegeBackup
                            </h3>

                            <p>
                                Respaldos registrados y pruebas
                                de restauración.
                            </p>

                            <span>
                                Revisar backups →
                            </span>

                        </div>

                    </a>


                    <!-- ALERT -->

                    <a asp-controller="AlertasSeguridad"
                       asp-action="Index"
                       asp-route-empresaId="@Model.Id"
                       class="profile-service-card">

                        <div class="profile-service-icon service-red">
                            AL
                        </div>

                        <div class="profile-service-content">

                            <h3>
                                ProtegeAlert
                            </h3>

                            <p>
                                Alertas, eventos de seguridad
                                y seguimiento.
                            </p>

                            <span>
                                Revisar alertas →
                            </span>

                        </div>

                    </a>


                    <!-- HUMAN -->

                    <a asp-controller="CapacitacionesSeguridad"
                       asp-action="Index"
                       asp-route-empresaId="@Model.Id"
                       class="profile-service-card">

                        <div class="profile-service-icon service-green">
                            HU
                        </div>

                        <div class="profile-service-content">

                            <h3>
                                ProtegeHuman
                            </h3>

                            <p>
                                Capacitación y concientización
                                del personal.
                            </p>

                            <span>
                                Ver capacitación →
                            </span>

                        </div>

                    </a>


                    <!-- CONTINUIDAD -->

                    <a asp-controller="PlanesContinuidad"
                       asp-action="Index"
                       asp-route-empresaId="@Model.Id"
                       class="profile-service-card">

                        <div class="profile-service-icon service-orange">
                            PC
                        </div>

                        <div class="profile-service-content">

                            <h3>
                                Continuidad digital
                            </h3>

                            <p>
                                Recuperación operativa, RPO,
                                RTO y responsables.
                            </p>

                            <span>
                                Ver continuidad →
                            </span>

                        </div>

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- ==================================================
         COLUMNA DERECHA
    =================================================== -->

    <div class="col-xl-4">


        <!-- INFORMACIÓN EMPRESA -->

        <div class="profile-panel mb-4">

            <div class="profile-panel-header">

                <div>

                    <span class="panel-eyebrow">
                        EMPRESA
                    </span>

                    <h2 class="profile-panel-title">
                        Información general
                    </h2>

                </div>

            </div>


            <div class="profile-panel-body">

                <div class="company-profile-info-list">


                    <div class="company-profile-info-item">

                        <span>
                            Nombre comercial
                        </span>

                        <strong>
                            @Model.Nombre
                        </strong>

                    </div>


                    <div class="company-profile-info-item">

                        <span>
                            RNC o cédula
                        </span>

                        <strong>
                            @Model.Rnc
                        </strong>

                    </div>


                    <div class="company-profile-info-item">

                        <span>
                            Sector
                        </span>

                        <strong>
                            @Model.Sector
                        </strong>

                    </div>


                    <div class="company-profile-info-item">

                        <span>
                            Plan
                        </span>

                        <strong>
                            @Model.Plan
                        </strong>

                    </div>


                    <div class="company-profile-info-item">

                        <span>
                            Empleados
                        </span>

                        <strong>
                            @Model.CantidadEmpleados
                        </strong>

                    </div>


                    <div class="company-profile-info-item">

                        <span>
                            Incorporación
                        </span>

                        <strong>
                            @(Model.FechaRegistro.ToString("dd/MM/yyyy"))
                        </strong>

                    </div>

                </div>

            </div>

        </div>


        <!-- CONTACTO -->

        <div class="profile-panel">

            <div class="profile-panel-header">

                <div>

                    <span class="panel-eyebrow">
                        CONTACTO
                    </span>

                    <h2 class="profile-panel-title">
                        Datos de contacto
                    </h2>

                </div>

            </div>


            <div class="profile-panel-body">

                <div class="company-contact-item">

                    <span class="company-contact-label">
                        Correo electrónico
                    </span>

                    @if (!string.IsNullOrWhiteSpace(Model.CorreoContacto))
                    {
                        <a href="mailto:@Model.CorreoContacto">
                            @Model.CorreoContacto
                        </a>
                    }
                    else
                    {
                        <span class="company-contact-empty">
                            No registrado
                        </span>
                    }

                </div>


                <div class="company-contact-item">

                    <span class="company-contact-label">
                        Teléfono
                    </span>

                    @if (!string.IsNullOrWhiteSpace(Model.Telefono))
                    {
                        <a href="tel:@Model.Telefono">
                            @Model.Telefono
                        </a>
                    }
                    else
                    {
                        <span class="company-contact-empty">
                            No registrado
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>

</div>