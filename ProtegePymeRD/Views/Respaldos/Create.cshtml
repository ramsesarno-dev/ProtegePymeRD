@model ProtegePymeRD.Models.Respaldo

@{
    ViewData["Title"] = "Registrar respaldo";
}

<div class="row justify-content-center">
    <div class="col-xl-9 col-lg-10">

        <div class="mb-4">
            <span class="text-success fw-semibold small">
                PROTEGEBACKUP
            </span>

            <h1 class="fw-bold mt-2 mb-2">
                Registrar respaldo
            </h1>

            <p class="text-muted mb-1">
                Empresa:
                <strong class="text-dark">
                    @ViewBag.EmpresaNombre
                </strong>
            </p>

            <p class="text-muted">
                Registra el estado del respaldo y verifica
                que la información pueda recuperarse.
            </p>
        </div>

        <form asp-action="Create"
              method="post"
              id="respaldoForm">

            <input asp-for="EmpresaId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4 p-md-5">

                    <h5 class="fw-bold mb-1">
                        Información protegida
                    </h5>

                    <p class="text-muted mb-4">
                        Identifica el recurso y dónde se almacena.
                    </p>

                    <div class="row g-4">

                        <div class="col-12">
                            <label asp-for="RecursoProtegido"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="RecursoProtegido"
                                   class="form-control form-control-lg"
                                   placeholder="Ejemplo: Base de datos de facturación" />

                            <span asp-validation-for="RecursoProtegido"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Tipo"
                                   class="form-label fw-semibold">
                            </label>

                            <select asp-for="Tipo"
                                    asp-items="Html.GetEnumSelectList<TipoRespaldo>()"
                                    class="form-select form-select-lg">

                                <option value="">
                                    Selecciona el tipo
                                </option>
                            </select>

                            <span asp-validation-for="Tipo"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ProveedorDestino"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="ProveedorDestino"
                                   class="form-control form-control-lg"
                                   placeholder="Ejemplo: Microsoft OneDrive" />

                            <span asp-validation-for="ProveedorDestino"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Frecuencia"
                                   class="form-label fw-semibold">
                            </label>

                            <select asp-for="Frecuencia"
                                    asp-items="Html.GetEnumSelectList<FrecuenciaRespaldo>()"
                                    class="form-select form-select-lg">

                                <option value="">
                                    Selecciona la frecuencia
                                </option>
                            </select>

                            <span asp-validation-for="Frecuencia"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Estado"
                                   class="form-label fw-semibold">
                            </label>

                            <select asp-for="Estado"
                                    asp-items="Html.GetEnumSelectList<EstadoRespaldo>()"
                                    class="form-select form-select-lg">

                                <option value="">
                                    Selecciona el estado
                                </option>
                            </select>

                            <span asp-validation-for="Estado"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FechaUltimoRespaldo"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="FechaUltimoRespaldo"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   type="datetime-local"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="FechaUltimoRespaldo"
                                  class="text-danger small">
                            </span>
                        </div>

                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4 p-md-5">

                    <h5 class="fw-bold mb-1">
                        Prueba de restauración
                    </h5>

                    <p class="text-muted mb-4">
                        Un respaldo solo es confiable cuando se
                        comprueba que puede restaurarse.
                    </p>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="RestauracionProbada"
                               class="form-check-input"
                               id="restauracionProbada" />

                        <label asp-for="RestauracionProbada"
                               class="form-check-label fw-semibold">
                        </label>
                    </div>

                    <div id="fechaPruebaContenedor"
                         class="@(Model.RestauracionProbada ? "" : "d-none")">

                        <label asp-for="FechaUltimaPrueba"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="FechaUltimaPrueba"
                               type="date"
                               id="fechaUltimaPrueba"
                               class="form-control form-control-lg" />

                        <span asp-validation-for="FechaUltimaPrueba"
                              class="text-danger small">
                        </span>
                    </div>

                </div>
            </div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">

                    <label asp-for="Observaciones"
                           class="form-label fw-semibold">
                    </label>

                    <textarea asp-for="Observaciones"
                              class="form-control"
                              rows="4"
                              placeholder="Agrega detalles, errores encontrados o acciones pendientes"></textarea>

                    <span asp-validation-for="Observaciones"
                          class="text-danger small">
                    </span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mb-5">

                <a asp-controller="Empresas"
                   asp-action="Index"
                   class="btn btn-light px-4">
                    Cancelar
                </a>

                <button type="submit"
                        id="btnGuardarRespaldo"
                        class="btn btn-success px-4">
                    Guardar respaldo
                </button>

            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const interruptor =
                document.getElementById("restauracionProbada");

            const contenedor =
                document.getElementById("fechaPruebaContenedor");

            const fecha =
                document.getElementById("fechaUltimaPrueba");

            const formulario =
                document.getElementById("respaldoForm");

            const boton =
                document.getElementById("btnGuardarRespaldo");

            let enviando = false;

            function actualizarFechaPrueba() {
                if (interruptor.checked) {
                    contenedor.classList.remove("d-none");
                } else {
                    contenedor.classList.add("d-none");
                    fecha.value = "";
                }
            }

            interruptor.addEventListener(
                "change",
                actualizarFechaPrueba);

            formulario.addEventListener("submit", function (event) {
                if (enviando) {
                    event.preventDefault();
                    return;
                }

                if (typeof window.jQuery !== "undefined"
                    && !$(formulario).valid()) {
                    return;
                }

                enviando = true;
                boton.disabled = true;
                boton.textContent = "Guardando...";
            });

            actualizarFechaPrueba();
        });
    </script>
}