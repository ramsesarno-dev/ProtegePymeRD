@model IEnumerable<ProtegePymeRD.Models.Respaldo>

@{
    ViewData["Title"] = "ProtegeBackup";

    int total =
        Convert.ToInt32(ViewBag.TotalRespaldos ?? 0);

    int exitosos =
        Convert.ToInt32(ViewBag.RespaldosExitosos ?? 0);

    int restauraciones =
        Convert.ToInt32(ViewBag.RestauracionesProbadas ?? 0);

    int porcentajeExitosos = total == 0
        ? 0
        : (int)Math.Round(exitosos * 100.0 / total);
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">
        @TempData["MensajeExito"]
    </div>
}

<div class="d-flex flex-column flex-md-row
            justify-content-between align-items-md-end
            gap-3 mb-4">

    <div>
        <span class="text-success fw-semibold small">
            PROTEGEBACKUP
        </span>

        <h1 class="fw-bold mt-2 mb-2">
            Respaldos y restauraciones
        </h1>

        @if (ViewBag.EmpresaNombre != null)
        {
            <p class="text-muted mb-0">
                Empresa:
                <strong class="text-dark">
                    @ViewBag.EmpresaNombre
                </strong>
            </p>
        }
        else
        {
            <p class="text-muted mb-0">
                Estado general de los respaldos registrados.
            </p>
        }
    </div>

    @if (ViewBag.EmpresaId != null)
    {
        <a asp-action="Create"
           asp-route-empresaId="@ViewBag.EmpresaId"
           class="btn btn-success px-4">
            Registrar respaldo
        </a>
    }
</div>

<div class="row g-3 mb-4">

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">
                    Respaldos registrados
                </p>

                <span class="display-6 fw-bold">
                    @total
                </span>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">
                    Respaldos exitosos
                </p>

                <span class="display-6 fw-bold text-success">
                    @porcentajeExitosos%
                </span>

                <div class="small text-muted mt-2">
                    Meta del servicio: más de 95%
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">
                    Restauraciones verificadas
                </p>

                <span class="display-6 fw-bold">
                    @restauraciones
                </span>

                <div class="small text-muted mt-2">
                    De @total registros
                </div>
            </div>
        </div>
    </div>

</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <h5 class="fw-bold mb-1">
            Registros de respaldo
        </h5>

        <p class="text-muted mb-4">
            Consulta ejecuciones, destinos y pruebas de recuperación.
        </p>

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Información protegida</th>
                            <th>Tipo y destino</th>
                            <th>Frecuencia</th>
                            <th>Estado</th>
                            <th>Último respaldo</th>
                            <th>Restauración</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var respaldo in Model)
                        {
                            <tr>
                                <td>
                                    <strong>
                                        @respaldo.RecursoProtegido
                                    </strong>

                                    @if (ViewBag.EmpresaId == null)
                                    {
                                        <div class="small text-muted">
                                            @respaldo.Empresa?.Nombre
                                        </div>
                                    }
                                </td>

                                <td>
                                    <div>@respaldo.Tipo</div>

                                    <small class="text-muted">
                                        @respaldo.ProveedorDestino
                                    </small>
                                </td>

                                <td>
                                    @respaldo.Frecuencia
                                </td>

                                <td>
                                    @if (respaldo.Estado ==
                                                                EstadoRespaldo.Exitoso)
                                    {
                                        <span class="badge bg-success
                                                                 text-white">
                                            Exitoso
                                        </span>
                                    }
                                    else if (respaldo.Estado ==
                                    EstadoRespaldo.Fallido)
                                    {
                                        <span class="badge bg-danger
                                                                 text-white">
                                            Fallido
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning
                                                                 text-dark">
                                            Pendiente
                                        </span>
                                    }
                            </td>

                            <td>
                                @(respaldo.FechaUltimoRespaldo
                                                            .ToString("dd/MM/yyyy hh:mm tt"))
                        </td>

                                <td>
                            @if (respaldo.RestauracionProbada)
                                    {
                                        <span class="text-success
                                                                 fw-semibold">
                                            Verificada
                                        </span>

                                        @if (respaldo.FechaUltimaPrueba != null)
                                        {
                                            <div class="small text-muted">
                                                @(respaldo.FechaUltimaPrueba.Value
                                                                                .ToString("dd/MM/yyyy"))
                            </div>
                                                        }
                                    }
                                    else
                                    {
                                        <span class="text-danger
                                                                 fw-semibold">
                                            Sin probar
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <form asp-action="Eliminar"
                                          asp-route-id="@respaldo.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('¿Eliminar este registro de respaldo?');">

                                        <button type="submit"
                                                class="btn btn-sm
                                                               btn-outline-danger">
                                            Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h5 class="fw-bold">
                    No hay respaldos registrados
                </h5>

                <p class="text-muted">
                    Registra el primer respaldo para comenzar
                    el seguimiento de continuidad.
                </p>

                @if (ViewBag.EmpresaId != null)
                {
                    <a asp-action="Create"
                       asp-route-empresaId="@ViewBag.EmpresaId"
                       class="btn btn-success">
                        Registrar respaldo
                    </a>
                }
            </div>
        }

    </div>
</div>

<div class="mt-4 mb-5">
    <a asp-controller="Empresas"
       asp-action="Index"
       class="btn btn-light">
        Volver a empresas
    </a>
</div>