@model ProtegePymeRD.Models.Diagnostico

@{
    ViewData["Title"] = "Resultado ProtegeScore";

    string color = Model.Puntuacion >= 80
        ? "success"
        : Model.Puntuacion >= 60
            ? "warning"
            : "danger";

    int identificar =
        (Model.TieneInventarioActivos == true ? 10 : 0) +
        (Model.GestionaVulnerabilidades == true ? 10 : 0);

    int proteger =
        (Model.UtilizaMfa == true ? 10 : 0) +
        (Model.MantieneActualizaciones == true ? 10 : 0) +
        (Model.CapacitaEmpleados == true ? 10 : 0);

    int detectarResponder =
        (Model.MonitoreaAlertas == true ? 10 : 0) +
        (Model.TienePlanIncidentes == true ? 10 : 0) +
        (Model.TieneResponsables == true ? 10 : 0);

    int recuperar =
        (Model.RealizaRespaldos == true ? 10 : 0) +
        (Model.PruebaRestauraciones == true ? 10 : 0);
}

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">
        @TempData["MensajeExito"]
    </div>
}

<div class="mb-4">
    <span class="text-success fw-semibold small">
        RESULTADO DEL DIAGNÓSTICO
    </span>

    <h1 class="fw-bold mt-2 mb-2">
        ProtegeScore
    </h1>

    <p class="text-muted">
        Resultado de seguridad y continuidad digital de
        <strong class="text-dark">@Model.Empresa?.Nombre</strong>.
    </p>
</div>

<div class="row g-4 mb-4">

    <div class="col-lg-4">
        <div class="card border-@color shadow-sm h-100">
            <div class="card-body text-center p-5">

                <p class="text-muted mb-2">
                    Puntuación obtenida
                </p>

                <div class="display-1 fw-bold text-@color">
                    @Model.Puntuacion
                </div>

                <div class="fs-5 text-muted mb-3">
                    de 100 puntos
                </div>

                <span class="badge bg-@color text-white fs-6 px-3 py-2">
                    @Model.Nivel
                </span>

                <hr class="my-4" />

                <div class="text-muted small">
                    Evaluado el
                    @Model.FechaEvaluacion.ToString("dd/MM/yyyy hh:mm tt")
                </div>

                <div class="text-muted small mt-1">
                    Por: @Model.UsuarioEvaluador
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4 p-md-5">

                <h5 class="fw-bold mb-1">
                    Resultados por área
                </h5>

                <p class="text-muted mb-4">
                    Distribución de los controles evaluados.
                </p>

                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="fw-semibold">Identificar</span>
                        <span>@identificar / 20</span>
                    </div>

                    <div class="progress" style="height: 9px;">
                        <div class="progress-bar bg-success"
                             style="width: @(identificar * 100 / 20)%">
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="fw-semibold">Proteger</span>
                        <span>@proteger / 30</span>
                    </div>

                    <div class="progress" style="height: 9px;">
                        <div class="progress-bar bg-success"
                             style="width: @(proteger * 100 / 30)%">
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="fw-semibold">
                            Detectar y responder
                        </span>
                        <span>@detectarResponder / 30</span>
                    </div>

                    <div class="progress" style="height: 9px;">
                        <div class="progress-bar bg-success"
                             style="width: @(detectarResponder * 100 / 30)%">
                        </div>
                    </div>
                </div>

                <div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="fw-semibold">Recuperar</span>
                        <span>@recuperar / 20</span>
                    </div>

                    <div class="progress" style="height: 9px;">
                        <div class="progress-bar bg-success"
                             style="width: @(recuperar * 100 / 20)%">
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4 p-md-5">

        <h5 class="fw-bold mb-1">
            Recomendaciones prioritarias
        </h5>

        <p class="text-muted mb-4">
            Acciones sugeridas según las brechas identificadas.
        </p>

        @if (Model.Puntuacion == 100)
        {
            <div class="alert alert-success mb-0">
                La empresa cumple todos los controles básicos evaluados.
                Debe mantenerlos y verificar su efectividad periódicamente.
            </div>
        }
        else
        {
            <div class="list-group">

                @if (Model.TieneInventarioActivos != true)
                {
                    <div class="list-group-item p-3">
                        Crear un inventario actualizado de equipos,
                        sistemas, aplicaciones y cuentas críticas.
                    </div>
                }

                @if (Model.GestionaVulnerabilidades != true)
                {
                    <div class="list-group-item p-3">
                        Implementar revisiones periódicas de
                        vulnerabilidades y aplicar correcciones.
                    </div>
                }

                @if (Model.UtilizaMfa != true)
                {
                    <div class="list-group-item p-3">
                        Activar autenticación multifactor en correos,
                        banca, nube y cuentas administrativas.
                    </div>
                }

                @if (Model.MantieneActualizaciones != true)
                {
                    <div class="list-group-item p-3">
                        Establecer un calendario para actualizar
                        equipos y aplicaciones.
                    </div>
                }

                @if (Model.CapacitaEmpleados != true)
                {
                    <div class="list-group-item p-3">
                        Capacitar al personal sobre phishing,
                        fraude e ingeniería social.
                    </div>
                }

                @if (Model.MonitoreaAlertas != true)
                {
                    <div class="list-group-item p-3">
                        Configurar monitoreo de alertas y actividades
                        sospechosas.
                    </div>
                }

                @if (Model.TienePlanIncidentes != true)
                {
                    <div class="list-group-item p-3">
                        Documentar un procedimiento de respuesta
                        ante incidentes.
                    </div>
                }

                @if (Model.TieneResponsables != true)
                {
                    <div class="list-group-item p-3">
                        Definir responsables y canales de contacto
                        para emergencias digitales.
                    </div>
                }

                @if (Model.RealizaRespaldos != true)
                {
                    <div class="list-group-item p-3">
                        Implementar respaldos periódicos de la
                        información crítica.
                    </div>
                }

                @if (Model.PruebaRestauraciones != true)
                {
                    <div class="list-group-item p-3">
                        Programar pruebas de restauración para
                        comprobar que los respaldos funcionan.
                    </div>
                }

            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
        {
            <div class="mt-4">
                <h6 class="fw-bold">Observaciones</h6>
                <p class="text-muted mb-0">
                    @Model.Observaciones
                </p>
            </div>
        }

    </div>
</div>

<div class="d-flex flex-wrap justify-content-end gap-2 mb-5">

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-light">
        Ir al panel
    </a>

    <a asp-controller="Empresas"
       asp-action="Index"
       class="btn btn-outline-success">
        Ver empresas
    </a>

    <a asp-action="Create"
       asp-route-empresaId="@Model.EmpresaId"
       class="btn btn-success">
        Realizar otra evaluación
    </a>

</div>