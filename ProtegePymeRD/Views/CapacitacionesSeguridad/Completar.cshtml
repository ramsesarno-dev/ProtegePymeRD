@using ProtegePymeRD.Models
@model CapacitacionSeguridad

@{
    ViewData["Title"] = "Seguimiento de capacitación";
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger">
        @TempData["MensajeError"]
    </div>
}

<div class="row justify-content-center">
    <div class="col-xl-8">

        <div class="mb-4">
            <span class="text-success fw-semibold small">
                SEGUIMIENTO FORMATIVO
            </span>

            <h1 class="fw-bold mt-2 mb-2">
                Seguimiento de capacitación
            </h1>

            <p class="text-muted">
                Empresa:
                <strong class="text-dark">
                    @Model.Empresa?.Nombre
                </strong>
            </p>
        </div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">

                <h4 class="fw-bold">
                    @Model.Titulo
                </h4>

                <p class="text-muted">
                    @Model.Descripcion
                </p>

                <hr />

                <div class="row g-3">
                    <div class="col-md-4">
                        <span class="text-muted">Tema</span>

                        <div class="fw-semibold">
                            @Html.DisplayFor(model => model.Tema)
                        </div>
                    </div>

                    <div class="col-md-4">
                        <span class="text-muted">Duración</span>

                        <div class="fw-semibold">
                            @Model.DuracionMinutos minutos
                        </div>
                    </div>

                    <div class="col-md-4">
                        <span class="text-muted">Programada</span>

                        <div class="fw-semibold">
                            @Model.FechaProgramada.ToString(
                            "dd/MM/yyyy hh:mm tt")
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <form asp-action="Completar" method="post">
            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">

                    <h4 class="fw-bold mb-1">
                        Resultados
                    </h4>

                    <p class="text-muted mb-4">
                        Registra la participación y el estado.
                    </p>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <label asp-for="Estado"
                                   class="form-label">
                            </label>

                            <select asp-for="Estado"
                                    asp-items="Html.GetEnumSelectList<EstadoCapacitacion>()"
                                    class="form-select">
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Responsable"
                                   class="form-label">
                            </label>

                            <input asp-for="Responsable"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CantidadParticipantes"
                                   class="form-label">
                            </label>

                            <input asp-for="CantidadParticipantes"
                                   type="number"
                                   min="0"
                                   class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CantidadAprobados"
                                   class="form-label">
                            </label>

                            <input asp-for="CantidadAprobados"
                                   type="number"
                                   min="0"
                                   class="form-control" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Observaciones"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Observaciones"
                                      rows="4"
                                      class="form-control"
                                      placeholder="Describe los resultados y oportunidades de mejora."></textarea>
                        </div>

                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mb-5">
                <a asp-action="Index"
                   asp-route-empresaId="@Model.EmpresaId"
                   class="btn btn-light px-4">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-success px-4">
                    Guardar resultados
                </button>
            </div>
        </form>

    </div>
</div>