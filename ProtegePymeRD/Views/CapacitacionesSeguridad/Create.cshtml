@using ProtegePymeRD.Models
@model CapacitacionSeguridad

@{
    ViewData["Title"] = "Programar capacitación";
    var empresa = ViewBag.Empresa as Empresa;
}

<div class="row justify-content-center">
    <div class="col-xl-9">

        <div class="mb-4">
            <span class="text-success fw-semibold small">
                PROTEGEHUMAN
            </span>

            <h1 class="fw-bold mt-2 mb-2">
                Programar capacitación
            </h1>

            <p class="text-muted">
                Empresa:
                <strong class="text-dark">@empresa?.Nombre</strong>
            </p>
        </div>

        <form asp-action="Create" method="post">
            <input asp-for="EmpresaId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">

                    <h4 class="fw-bold mb-1">
                        Actividad formativa
                    </h4>

                    <p class="text-muted mb-4">
                        Define el contenido, fecha y responsable.
                    </p>

                    <div class="row g-4">

                        <div class="col-12">
                            <label asp-for="Titulo"
                                   class="form-label">
                            </label>

                            <input asp-for="Titulo"
                                   class="form-control"
                                   placeholder="Ejemplo: Cómo identificar correos de phishing" />

                            <span asp-validation-for="Titulo"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Tema"
                                   class="form-label">
                            </label>

                            <select asp-for="Tema"
                                    asp-items="Html.GetEnumSelectList<TemaCapacitacion>()"
                                    class="form-select">
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DuracionMinutos"
                                   class="form-label">
                            </label>

                            <input asp-for="DuracionMinutos"
                                   type="number"
                                   min="5"
                                   max="240"
                                   class="form-control" />

                            <span asp-validation-for="DuracionMinutos"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Descripcion"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Descripcion"
                                      rows="4"
                                      class="form-control"
                                      placeholder="Describe los objetivos y contenidos de la capacitación."></textarea>

                            <span asp-validation-for="Descripcion"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FechaProgramada"
                                   class="form-label">
                            </label>

                            <input asp-for="FechaProgramada"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   type="datetime-local"
                                   class="form-control" />

                            <span asp-validation-for="FechaProgramada"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Responsable"
                                   class="form-label">
                            </label>

                            <input asp-for="Responsable"
                                   class="form-control"
                                   placeholder="Nombre del facilitador" />

                            <span asp-validation-for="Responsable"
                                  class="text-danger"></span>
                        </div>

                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mb-5">
                <a asp-action="Index"
                   asp-route-empresaId="@Model.EmpresaId"
                   class="btn btn-light px-4">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-success px-4">
                    Programar capacitación
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}